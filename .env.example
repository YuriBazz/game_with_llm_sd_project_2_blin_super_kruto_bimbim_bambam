LLM_PROVIDER=ollama

OLLAMA_URL=http://ollama:11434
# Must match the model pulled by the ollama service in docker-compose.yml.
# AMD iGPU ~8GB: qwen2.5:3b fits GPU reliably; 7b often crashes Vulkan (DeviceLost).
# For 7b anyway: OLLAMA_NUM_GPU=0 (CPU, slow) or OLLAMA_VULKAN=0 in docker-compose.
OLLAMA_MODEL=qwen2.5:3b
# OLLAMA_NUM_GPU=0

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

MAX_STEPS=500
MAX_TOKENS=5000
TEMPERATURE=0.7
GAME_SEED=42

# Spectator: fly camera, full map, robots H+A via LLM (GODMODE=true by default)
GODMODE=true

# Robot A (rival slot) — primary model
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:3b

# Robot H (player slot) — different model (both robots use ollama by default)
LLM_PROVIDER_PLAYER=ollama
OLLAMA_MODEL_PLAYER=qwen2.5:3b

MAX_TOTAL_TOKENS=50000

# AMD iGPU (default compose): /dev/dri + OLLAMA_VULKAN=1
# If permission denied on /dev/dri: RENDER_GID=989 VIDEO_GID=985 (getent group render video)
# NVIDIA: docker compose -f docker-compose.yml -f docker-compose.nvidia.yml up
# HSA_OVERRIDE_GFX_VERSION=10.3.0
